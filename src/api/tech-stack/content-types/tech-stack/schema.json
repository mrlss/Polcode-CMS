{
  "kind": "collectionType",
  "collectionName": "tech_stacks",
  "info": {
    "singularName": "tech-stack",
    "pluralName": "tech-stacks",
    "displayName": "Tech Stack",
    "description": "Technologies: the Tech Stack section, the Technologies filter and the tech list on services"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "link": {
      "type": "string"
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "mappedBy": "techStack"
    },
    "caseStudies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study",
      "inversedBy": "techStack"
    }
  }
}
