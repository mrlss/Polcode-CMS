{
  "kind": "collectionType",
  "collectionName": "platforms",
  "info": {
    "singularName": "platform",
    "pluralName": "platforms",
    "displayName": "Platforms",
    "description": "Platforms (e.g. awards platforms)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "achievements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::achievement.achievement",
      "mappedBy": "platform"
    }
  }
}
