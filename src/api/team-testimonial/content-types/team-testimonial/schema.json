{
  "kind": "collectionType",
  "collectionName": "team_testimonials",
  "info": {
    "singularName": "team-testimonial",
    "pluralName": "team-testimonials",
    "displayName": "Team Testimonials",
    "description": "Team testimonials — no client relation, optional image"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "author": {
      "type": "string",
      "required": true
    },
    "position": {
      "type": "string"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "text": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  }
}
