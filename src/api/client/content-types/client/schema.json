{
  "kind": "collectionType",
  "collectionName": "clients",
  "info": {
    "singularName": "client",
    "pluralName": "clients",
    "displayName": "Clients",
    "description": "Clients with testimonials"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "name": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::client-testimonial.client-testimonial",
      "mappedBy": "client"
    }
  }
}
