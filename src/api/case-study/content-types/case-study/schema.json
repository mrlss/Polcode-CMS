{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Studies",
    "description": "Case study entries, filterable by industry/service/tech stack/region"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "description": "Page this case study is listed under (e.g. the Case Studies hub). The public URL is the parent's path plus the slug."
    },
    "title": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "shortTitle": {
      "type": "string"
    },
    "shortDescription": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "featuredMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "industries": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::industry.industry",
      "inversedBy": "relatedCases",
      "description": "The industry this case study belongs to. Exactly one — it cannot belong to several industries."
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "mappedBy": "caseStudies",
      "description": "Services this case study was delivered for. This is the same link as 'Case studies' on each service — filling it in here also lists the case study there, and vice versa. The Cases filters and the related-cases carousels read from it."
    },
    "techStack": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tech-stack.tech-stack",
      "mappedBy": "caseStudies",
      "description": "Technologies used on this project. The same link as 'Case studies' on each technology. Shown as tags on the case cards and used by the Technologies filter."
    },
    "regions": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region",
      "inversedBy": "caseStudies",
      "description": "The region this case study belongs to. Exactly one — it cannot belong to several regions."
    },
    "foreground": {
      "type": "enumeration",
      "default": "purple",
      "enum": [
        "purple",
        "gray",
        "yellow",
        "blue"
      ]
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-content-body",
        "sections.cta",
        "sections.case-studies",
        "sections.form"
      ],
      "description": "The page content, in the order shown here. Add, remove and drag to reorder — the published page follows this order."
    }
  }
}
