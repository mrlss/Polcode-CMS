{
  "kind": "collectionType",
  "collectionName": "client_testimonials",
  "info": {
    "singularName": "client-testimonial",
    "pluralName": "client-testimonials",
    "displayName": "Client Testimonials",
    "description": "Client testimonials — each one belongs to a single client"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "author": {
      "type": "string",
      "required": true
    },
    "position": {
      "type": "string"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "text": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "client": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::client.client",
      "inversedBy": "testimonials"
    }
  }
}
