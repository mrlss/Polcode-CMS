{
  "collectionName": "components_global_errors",
  "info": {
    "displayName": "Error",
    "description": "Copy shown on the 404 and error screens"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button"
    }
  }
}
