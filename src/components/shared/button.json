{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "description": "Reusable CTA button: title, variant, scroll-to, and a link target (external URL or internal Page / Case Study / Insight)"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "dark",
        "light",
        "ghost-dark",
        "ghost-light",
        "solid-dark",
        "solid-light"
      ],
      "default": "dark"
    },
    "scrollTo": {
      "type": "string"
    },
    "linkType": {
      "type": "enumeration",
      "enum": [
        "external",
        "internal"
      ],
      "default": "external"
    },
    "url": {
      "type": "string"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "caseStudy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::case-study.case-study"
    },
    "insight": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight.insight"
    }
  }
}
