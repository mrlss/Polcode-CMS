{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "description": "Reusable CTA button: title, optional scroll-to, and a single link target (external URL or internal Page / Case Study / Insight)"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "light",
        "dark",
        "ghostLight",
        "ghostDark",
        "solidLight",
        "solidDark",
        "link"
      ],
      "default": null
    },
    "scrollTo": {
      "type": "string"
    },
    "linkType": {
      "type": "enumeration",
      "enum": [
        "url",
        "page",
        "caseStudy",
        "insight"
      ],
      "default": "url"
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "url"
          ]
        }
      }
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "page"
          ]
        }
      }
    },
    "caseStudy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::case-study.case-study",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "caseStudy"
          ]
        }
      }
    },
    "insight": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight.insight",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "insight"
          ]
        }
      }
    }
  }
}
