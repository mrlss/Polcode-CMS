{
  "collectionName": "components_shared_floating_cards",
  "info": {
    "displayName": "Floating Card",
    "description": "Card for floating boxes"
  },
  "options": {},
  "attributes": {
    "value": {
      "type": "float",
      "description": "Figure the box counts up to on reveal, e.g. 1.7 (leave empty for a text-only box)"
    },
    "suffix": {
      "type": "string",
      "description": "Written straight after the figure: k+, +, % …"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    }
  }
}
