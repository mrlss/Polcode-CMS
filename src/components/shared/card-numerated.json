{
  "collectionName": "components_shared_card_numerateds",
  "info": {
    "displayName": "Numbered Card",
    "description": "One numbered card: title, copy and optional media"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    }
  }
}
