      "repeatable": false
    },
    "content": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "grid"
          ]
        }
      },
      "component": "shared.content-item",
      "repeatable": false
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    }
