{
  "collectionName": "components_sections_content_numerateds",
  "info": {
    "displayName": "Numbered Content",
    "description": "Numbered rows of content, always open or expandable"
  },
  "options": {},
  "attributes": {
    "anchor": {
      "type": "string",
      "description": "DOM id / URL hash for this section (e.g. \"industries\" → #industries). Lets nav links target this section on the page."
    },
    "headline": {
      "type": "component",
      "component": "shared.headline",
      "repeatable": false
    },
    "subtitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "layout"
            },
            "buttonOnSide"
          ]
        }
      }
    },
    "button": {
      "type": "component",
      "component": "shared.button",
      "repeatable": false
    },
    "layout": {
      "type": "enumeration",
      "default": "buttonBelow",
      "enum": [
        "buttonBelow",
        "buttonOnSide"
      ]
    },
    "behavior": {
      "type": "enumeration",
      "default": "static",
      "enum": [
        "static",
        "expandable"
      ]
    },
    "items": {
      "type": "component",
      "component": "shared.content-item",
      "repeatable": true
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    }
  }
}
