      "type": "enumeration",
      "enum": [
        "carousel",
        "grid"
      ],
      "default": "carousel"
    },
    "cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial"
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "shared.theme"
    }
  }
}
