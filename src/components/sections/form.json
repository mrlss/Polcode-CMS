{
  "collectionName": "components_sections_forms",
  "info": {
    "displayName": "Forms",
    "description": "Contact form (default / hero) or newsletter sign-up (compact)"
  },
  "options": {},
  "attributes": {
    "anchor": {
      "type": "string",
      "description": "DOM id / URL hash for this section (e.g. \"contact\" → #contact). Lets nav links target this section on the page."
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "default",
        "hero",
        "compact"
      ],
      "default": "default"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "hubspotFormID": {
      "type": "string",
      "description": "HubSpot form ID, e.g. \"0cf3d2c3-1c1a-4c0b-9f1e-2b0c1a2b3c4d\"."
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "variant"
            },
            "compact"
          ]
        }
      }
    },
    "label": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "compact"
          ]
        }
      }
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "shared.theme"
    }
  }
}
