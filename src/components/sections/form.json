{
  "collectionName": "components_sections_forms",
  "info": {
    "displayName": "Form",
    "description": "Contact or CV form section"
  },
  "options": {},
  "attributes": {
    "anchor": {
      "type": "string",
      "description": "DOM id / URL hash for this section (e.g. \"industries\" → #industries). Lets nav links target this section on the page."
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "contact",
        "cv"
      ],
      "default": "contact"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "label": {
      "type": "string"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "shared.theme"
    }
  }
}
