{
  "collectionName": "components_sections_heroes",
  "info": {
    "displayName": "Hero",
    "description": "Hero section — default (large heading), two columns, with carousel or with showreel"
  },
  "options": {},
  "attributes": {
    "variant": {
      "type": "enumeration",
      "enum": [
        "default",
        "withCarousel",
        "withShowreel",
        "twoColumns"
      ],
      "default": "default"
    },
    "label": {
      "type": "string",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "title": {
      "type": "text"
    },
    "subtitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withShowreel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withShowreel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "indicatorText": {
      "type": "string",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "carousel": {
      "type": "component",
      "repeatable": true,
      "component": "shared.hero-promo",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withCarousel"
          ]
        }
      }
    },
    "showreel": {
      "type": "component",
      "repeatable": false,
      "component": "shared.showreel",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "shared.theme"
    }
  }
}
