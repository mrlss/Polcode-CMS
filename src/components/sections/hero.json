{
  "collectionName": "components_sections_heroes",
  "info": {
    "displayName": "Hero",
    "description": "Hero section — default (large heading), two columns, with carousel or with showreel"
  },
  "options": {},
  "attributes": {
    "anchor": {
      "type": "string",
      "description": "DOM id / URL hash for this section (e.g. \"industries\" → #industries). Lets nav links target this section on the page."
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "default",
        "withCarousel",
        "withShowreel",
        "twoColumns"
      ],
      "default": "default"
    },
    "label": {
      "type": "string",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "title": {
      "type": "text"
    },
    "subtitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withShowreel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withShowreel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "indicatorText": {
      "type": "string",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "default"
              ]
            },
            {
              "==": [
                {
                  "var": "variant"
                },
                "twoColumns"
              ]
            }
          ]
        }
      }
    },
    "carouselSource": {
      "type": "enumeration",
      "default": "vacancies",
      "enum": [
        "vacancies",
        "promos"
      ],
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withCarousel"
          ]
        }
      },
      "description": "What the small carousel shows. `vacancies`: the newest open positions, pulled live from Traffit — nothing to maintain here. `promos`: the promo slides you write below, for any other kind of content."
    },
    "carouselLimit": {
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 10,
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "carouselSource"
                },
                "vacancies"
              ]
            }
          ]
        }
      },
      "description": "How many open positions to show, newest first. Each slide is the position name, its location and a link to its page."
    },
    "vacancyCtaLabel": {
      "type": "string",
      "default": "See position",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "carouselSource"
                },
                "vacancies"
              ]
            }
          ]
        }
      },
      "description": "Button text on each position slide. Leave empty for \"See position\"."
    },
    "carousel": {
      "type": "component",
      "repeatable": true,
      "component": "shared.hero-promo",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "variant"
                },
                "withCarousel"
              ]
            },
            {
              "==": [
                {
                  "var": "carouselSource"
                },
                "promos"
              ]
            }
          ]
        }
      },
      "description": "Your own promo slides, in this order. Used when Carousel shows is `promos`, and as the safety net when Traffit has no open positions."
    },
    "showreel": {
      "type": "component",
      "repeatable": false,
      "component": "shared.showreel",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "withShowreel"
          ]
        }
      }
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "shared.theme"
    }
  }
}
