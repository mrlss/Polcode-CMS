{
  "collectionName": "components_shared_ctas",
  "info": {
    "displayName": "CTA",
    "description": "Call-to-action block: label, title, description, buttons, background image, text color"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "buttons": {
      "type": "component",
      "component": "shared.button",
      "repeatable": true
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    },
    "mediaMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
