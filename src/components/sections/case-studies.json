{
  "collectionName": "components_sections_case_studies",
  "info": {
    "displayName": "Case Studies",
    "description": "Case studies section, latest or manual"
  },
  "options": {},
  "attributes": {
    "pick": {
      "type": "enumeration",
      "default": "latest",
      "enum": [
        "latest",
        "manual",
        "next"
      ]
    },
    "headline": {
      "type": "component",
      "component": "shared.headline",
      "repeatable": false
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    },
    "button": {
      "type": "component",
      "component": "shared.button",
      "repeatable": false
    },
    "caseStudies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-study.case-study",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "pick"
            },
            "manual"
          ]
        }
      }
    }
  }
}
