{
  "collectionName": "components_sections_portfolios",
  "info": {
    "displayName": "Portfolio",
    "icon": "briefcase",
    "description": "Featured + other case studies with taxonomy filters and optional show-more/less"
  },
  "options": {},
  "attributes": {
    "anchor": {
      "type": "string",
      "description": "DOM id / URL hash for this section (e.g. \"industries\" → #industries). Lets nav links target this section on the page."
    },
    "headline": {
      "type": "component",
      "component": "shared.headline",
      "repeatable": false
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    },
    "listMode": {
      "type": "enumeration",
      "default": "showMore",
      "enum": [
        "showMore",
        "loadMore",
        "none"
      ],
      "description": "How the other cases end: `showMore` = collapse them behind a Show more/less toggle, `loadMore` = page them with the Load more button, `none` = list every other case with no control."
    },
    "showMore": {
      "type": "component",
      "repeatable": false,
      "component": "shared.show-more",
      "description": "Toggle labels + how many other cases stay visible. Used when List ending is `showMore`.",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "listMode"
            },
            "showMore"
          ]
        }
      }
    },
    "loadMore": {
      "type": "component",
      "repeatable": false,
      "component": "shared.load-more",
      "description": "First batch on load, another batch per click. Used when List ending is `loadMore`.",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "listMode"
            },
            "loadMore"
          ]
        }
      }
    },
    "filters": {
      "type": "component",
      "repeatable": true,
      "component": "portfolio.filter",
      "description": "Which taxonomy dropdowns the list offers, in order. Leave empty for all four (Industries, Services, Technologies, Region)."
    },
    "manualCasesControl": {
      "type": "boolean",
      "default": false
    },
    "sort": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "manualCasesControl"
            },
            false
          ]
        }
      },
      "default": "asc",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "featuredCases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-study.case-study",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "manualCasesControl"
            },
            true
          ]
        }
      }
    },
    "otherCases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-study.case-study",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "manualCasesControl"
            },
            true
          ]
        }
      }
    }
  }
}
